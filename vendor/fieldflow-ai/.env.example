# Inbound: key FieldFlow sends when calling this service
AI_SERVICE_INBOUND_KEY=replace-me-inbound

# Outbound: service key this service sends to FieldFlow's internal results route
AI_SERVICE_OUTBOUND_KEY=replace-me-outbound

# FieldFlow internal results endpoint
FIELDFLOW_API_BASE_URL=http://localhost:3000

# AI Grid (OpenAI Chat Completions, https://app.ai-grid.io/v1)
LLM_BASE_URL=https://app.ai-grid.io/v1
LLM_API_KEY=replace-me-ai-grid-key
LLM_MODEL=Qwen/Qwen3.8-27B
# AI Grid may not honour response_format; set "true" only if your deployment supports JSON mode.
LLM_JSON_MODE=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_MS=60000

# Callback delivery to FieldFlow
CALLBACK_TIMEOUT_MS=10000

# Server
PORT=4100
LOG_LEVEL=info

# claims (default): the model writes typed claims about code-detected findings.
# legacy: the model writes the report fields directly (rollback switch).
OUTPUT_MODE=claims
