# development | test | production
NODE_ENV=development
# HTTP port of the API
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
# PostgreSQL connection strings (user, password and port must match the root .env)
DATABASE_URL=postgresql://fieldflow:change-me-locally@127.0.0.1:5432/fieldflow_dev
# Test database: used by the API when NODE_ENV=test and by the test suite (migrated automatically)
DATABASE_URL_TEST=postgresql://fieldflow:change-me-locally@127.0.0.1:5432/fieldflow_test
# Access-token signing key (HS256), at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Access-token lifetime (s, m or h), 60s to 24h
ACCESS_TOKEN_TTL=15m
# Refresh-token lifetime in days (1-90)
REFRESH_TOKEN_TTL_DAYS=7
# true | false. Unset = Secure cookies everywhere except NODE_ENV=development (http://localhost)
# COOKIE_SECURE=true
# Uploaded files. Relative paths resolve from apps/api; must not be inside apps/web. Created at start-up.
UPLOAD_DIR=./var/uploads
# Storage adapter for uploaded files: local (only value for now)
STORAGE_DRIVER=local
# The single agency created by `npm run db:seed` (code: ^[A-Z0-9-]{2,20}$)
SEED_AGENCY_NAME=FieldFlow Demo Agency
SEED_AGENCY_CODE=FIELDFLOW

# Required only for npm run db:seed -- --demo
DEMO_PASSWORD=

# Direct connections: false. Set to 1 when Caddy is the only trusted proxy hop.
TRUST_PROXY=false

# PostgreSQL background workers and maintenance scheduling. Disabled by default in tests.
JOBS_ENABLED=true

# AI service (separate repo: fieldflow-ai). Leave AI_SERVICE_BASE_URL empty to disable the AI module.
# The two keys are different secrets of at least 32 characters, shared with the AI service's .env.
# Generate each with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AI_SERVICE_BASE_URL=
# Bearer key FieldFlow sends when calling the AI service
AI_SERVICE_INBOUND_KEY=
# Bearer key the AI service sends to POST /api/v1/internal/ai/results
AI_SERVICE_OUTBOUND_KEY=
