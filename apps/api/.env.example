# development | test | production
NODE_ENV=development
# HTTP port of the API
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
# PostgreSQL connection strings (user, password and port must match the root .env)
DATABASE_URL=postgresql://fieldflow:change-me-locally@127.0.0.1:5432/fieldflow_dev
# Test database: used by the API when NODE_ENV=test and by the test suite (migrated automatically)
DATABASE_URL_TEST=postgresql://fieldflow:change-me-locally@127.0.0.1:5432/fieldflow_test
# The single agency created by `npm run db:seed` (code: ^[A-Z0-9-]{2,20}$)
SEED_AGENCY_NAME=FieldFlow Demo Agency
SEED_AGENCY_CODE=FIELDFLOW
