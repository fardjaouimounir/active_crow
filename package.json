{
  "name": "fieldflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "lint": "eslint . && prettier --check .",
    "lint:quick": "eslint --quiet .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:quick": "vitest run --reporter=dot --silent=true --bail=1",
    "test:related": "vitest related --run --reporter=dot --silent=true",
    "verify": "npm run -s lint:quick && npm run -s test:quick",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "npm run db:generate -w @fieldflow/api",
    "db:migrate": "npm run db:migrate -w @fieldflow/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @fieldflow/api",
    "db:reset": "npm run db:reset -w @fieldflow/api",
    "db:seed": "npm run db:seed -w @fieldflow/api",
    "db:bootstrap": "npm run db:bootstrap -w @fieldflow/api --",
    "db:studio": "npm run db:studio -w @fieldflow/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vitest": "^5.1.1"
  }
}
